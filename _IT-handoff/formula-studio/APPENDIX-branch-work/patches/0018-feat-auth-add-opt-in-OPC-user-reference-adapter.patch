+function opcUserReferenceOn(){ return OPC_USER_REFERENCE_ENABLED === true; }
+function opcUserReferenceProvider(){
+  return typeof window !== 'undefined' && typeof window.__FS_OPC_USER_REFERENCE_PROVIDER__ === 'function'
