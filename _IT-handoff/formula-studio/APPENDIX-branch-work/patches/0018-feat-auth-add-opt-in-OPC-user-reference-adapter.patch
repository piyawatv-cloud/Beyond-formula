+    }
+    if(seen.has(opcUserId)) throw new Error('OPC_USER_REFERENCE_INVALID: duplicate OPC user id');
+    seen.add(opcUserId);
+    if(status !== 'active') return null;
+    return {opc_user_id:opcUserId,name,department,role,opc_login_email:opcLoginEmail,
