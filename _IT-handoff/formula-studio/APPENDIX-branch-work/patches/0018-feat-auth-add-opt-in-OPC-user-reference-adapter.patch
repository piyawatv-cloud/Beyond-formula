+}
+function normalizeOpcUserReferenceRows(rows){
+  if(!Array.isArray(rows)) throw new Error('OPC_USER_REFERENCE_INVALID: rows must be an array');
+  const seen = new Set();
+  return rows.map((row, index)=>{
+    if(!row || typeof row !== 'object') throw new Error('OPC_USER_REFERENCE_INVALID: row '+(index+1));
