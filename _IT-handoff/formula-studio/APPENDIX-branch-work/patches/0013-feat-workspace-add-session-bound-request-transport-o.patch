+/** Transport scoped to this mounted workspace, without exposing its bearer token. */
+function pwsRequest(state, origin, token){
+  const check = ()=>{
+    if(pwsState !== state || state.controller.signal.aborted) throw new Error('Workspace unavailable');
+    if(pwsContext() !== state.context){ teardownPrivateWorkspace(); throw new Error('Workspace unavailable'); }
+  };
+  return async function(path, options={}){
+    check();
+    if(typeof path !== 'string' || !path.startsWith('/api/private-workspaces/')) throw new Error('Invalid workspace path');
+    const url = new URL(path, origin);
+    if(url.origin !== origin || !url.pathname.startsWith('/api/private-workspaces/') ||
+        url.username || url.password || url.hash) throw new Error('Invalid workspace path');
+    const method = options.method || 'GET';
+    if(!['GET','POST'].includes(method)) throw new Error('Invalid workspace method');
+    const response = await fetch(url.toString(), {method,
+      headers:{Authorization:'Bearer ' + token, 'Content-Type':'application/json'},
+      body:method === 'POST' ? JSON.stringify(options.body || {}) : undefined,
+      credentials:'omit', cache:'no-store', redirect:'error', signal:state.controller.signal});
+    check();
+    if(!response.ok){
+      if([401,403,404].includes(response.status)) teardownPrivateWorkspace();
+      throw new Error('Workspace request failed');
+    }
+    const result = await response.json();
+    check();
+    return result;
+  };
+}
