diff --git a/runtime/deploy-approved-main.sh b/runtime/deploy-approved-main.sh
new file mode 100755
index 0000000..9e4bb73
--- /dev/null
+++ b/runtime/deploy-approved-main.sh
@@ -0,0 +1,16 @@
+#!/bin/sh
+set -eu
+
+repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+cd "$repo_dir"
+
+if ! git diff --quiet || ! git diff --cached --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
+  printf '%s\n' 'Refusing deployment: preserve or commit all local changes first.' >&2
+  exit 1
+fi
+
+git fetch --prune origin main
+git switch main
+git merge --ff-only origin/main
+./runtime/install-local-runtime.sh
+git rev-parse HEAD
