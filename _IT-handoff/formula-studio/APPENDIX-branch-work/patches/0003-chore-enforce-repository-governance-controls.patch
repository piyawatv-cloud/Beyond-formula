+++ b/runtime/install-local-runtime.sh
@@ -0,0 +1,13 @@
+#!/bin/sh
+set -eu
+
+repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+uid=$(id -u)
+label=com.beyond-formula.runtime
+plist="$repo_dir/runtime/$label.plist"
+
+mkdir -p "$repo_dir/runtime/logs"
+plutil -lint "$plist"
+launchctl bootout "gui/$uid/$label" 2>/dev/null || true
+launchctl bootstrap "gui/$uid" "$plist"
+printf 'Formula Studio runtime started: http://127.0.0.1:4173/\n'
diff --git a/runtime/rollback-to-commit.sh b/runtime/rollback-to-commit.sh
new file mode 100755
index 0000000..9d30a93
--- /dev/null
+++ b/runtime/rollback-to-commit.sh
@@ -0,0 +1,21 @@
+#!/bin/sh
+set -eu
+
+if [ "$#" -ne 1 ]; then
+  printf 'Usage: %s <approved-commit-sha>\n' "$0" >&2
+  exit 64
+fi
+
+repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+cd "$repo_dir"
+
+if ! git diff --quiet || ! git diff --cached --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
+  printf '%s\n' 'Refusing rollback: preserve or commit all local changes first.' >&2
+  exit 1
+fi
+
+git fetch --prune origin
+git merge-base --is-ancestor "$1" origin/main
+git checkout --detach "$1"
+./runtime/install-local-runtime.sh
+git rev-parse HEAD
