+async function sbPushChatEvents(){
+  if(!sbChatEventsOn() || !chatEventOutbox.length) return false;
+  let changed = false;
+  for(const item of chatEventOutbox.slice()){
+    await sbReq('rpc/fs_append_chat_event', {
+      method:'POST',
+      body:{p_event_id:item.eventId,p_job_id:item.jobId,p_payload:item.payload}
+    });
+    chatEventOutbox = chatEventOutbox.filter(x=>x.eventId!==item.eventId);
+    saveChatOutboxes();
+    changed = true;
+  }
+  return changed;
+}
+async function sbPushChatReads(){
+  if(!sbChatEventsOn() || !chatReadOutbox.length) return false;
+  for(const item of chatReadOutbox.slice()){
+    await sbReq('rpc/fs_mark_chat_seen', {
+      method:'POST', body:{p_job_id:item.jobId,p_seen_ts:item.seenTs}
+    });
+    chatReadOutbox = chatReadOutbox.filter(x=>x.jobId!==item.jobId);
+    saveChatOutboxes();
+  }
+  return true;
+}
