+let pwsCspWarned = false;
+
+/**
+ * อ่าน connect-src จาก CSP ของหน้านี้ · คืน null เมื่อไม่มี CSP หรือไม่มี connect-src
+ * (ไม่มี directive = เบราว์เซอร์ fallback ไป default-src ซึ่งเราถือว่า "ไม่รู้" และ
+ * ให้ผู้เรียกตัดสินใจแบบปิดไว้ก่อน)
+ */
+function pwsCspConnectSrc(){
+  const meta = document.querySelector('meta[http-equiv="Content-Security-Policy"]');
+  const content = meta && meta.getAttribute('content');
+  if(typeof content !== 'string' || content === '') return null;
+  for(const directive of content.split(';')){
+    const parts = directive.trim().split(/\s+/).filter(Boolean);
+    if(parts.length && parts[0].toLowerCase() === 'connect-src') return parts.slice(1);
+  }
+  return null;
+}
+
+/**
+ * CSP ยอมให้ยิงไป origin นี้หรือไม่ · ตอบ false เมื่อไม่มี CSP ให้ตรวจ เพื่อไม่ให้
+ * หน้าที่ลืมประกาศ CSP กลายเป็นทางผ่านที่ bundle ส่งข้อมูลออกไปไหนก็ได้
+ */
+function pwsCspAllowsConnect(origin){
+  const sources = pwsCspConnectSrc();
+  if(!sources) return false;
+  let target;
+  try{ target = new URL(origin); }catch(err){ return false; }
+  return sources.some(function(source){
+    if(source === '*') return true;
+    let candidate = source;
+    if(candidate.startsWith("'")) return false;            // 'self' ไม่ใช่ origin ภายนอก
+    if(candidate.indexOf('://') === -1) candidate = 'https://' + candidate;
+    const wildcard = candidate.indexOf('://*.');
+    if(wildcard !== -1){
+      const scheme = candidate.slice(0, wildcard + 3);
+      const suffix = candidate.slice(wildcard + 5).replace(/\/+$/, '');
+      if(scheme !== target.protocol + '//') return false;
+      if(!suffix || suffix.indexOf('*') !== -1) return false;
+      return target.host.length > suffix.length && target.host.endsWith('.' + suffix);
+    }
+    let parsed;
+    try{ parsed = new URL(candidate); }catch(err){ return false; }
+    if(parsed.pathname !== '/' || parsed.search || parsed.hash) return false;
+    return parsed.origin === target.origin;
+  });
+}
+
 /** origin ที่อนุมัติต้องเป็น HTTPS origin เปล่า ๆ เท่านั้น ไม่มี path ไม่มี wildcard */
