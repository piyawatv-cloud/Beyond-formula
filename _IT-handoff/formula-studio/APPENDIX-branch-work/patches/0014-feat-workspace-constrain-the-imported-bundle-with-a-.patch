   if(!/^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$/.test(url.hostname)) return '';
   if(value.replace(/\/+$/,'') !== url.origin) return '';
+  // fail-closed: bundle รันใน origin เดียวกับ Formula ถ้า CSP ไม่ได้อนุญาต origin นี้
+  // ไว้ การ mount จะได้ workspace ที่ยิง request ไม่ออก และ operator จะไม่รู้สาเหตุ
+  if(!pwsCspAllowsConnect(url.origin)){
+    if(!pwsCspWarned){
+      pwsCspWarned = true;
+      console.error('private workspace: configured origin is not allowed by the page connect-src policy; refusing to mount');
+    }
+    return '';
+  }
   return url.origin;
 }
 
