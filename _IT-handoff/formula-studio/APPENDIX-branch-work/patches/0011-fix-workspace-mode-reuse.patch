 1 file changed, 32 insertions(+), 6 deletions(-)

diff --git a/index.html b/index.html
index 8ab2ac4..ae30909 100755
--- a/index.html
+++ b/index.html
@@ -6581,6 +6581,13 @@ async function sbCycle(){
     await sbPush();
     sbApply(await sbPull());
     sbErr = '';
+    // ตรวจสิทธิ์ของพื้นที่ทำงานส่วนตัวซ้ำทุกรอบ
+    //
+    // เดิมเรียกแค่ตอน sbBoot แปลว่าถ้าสิทธิ์ถูกถอน role เปลี่ยน หรือได้ 403
+    // ระหว่างเปิดแท็บทิ้งไว้ ปุ่มกับ panel จะยังอยู่จนกว่าผู้ใช้จะรีเฟรชเอง
+    // ซึ่งขัดกับสัญญาที่ว่า "สิทธิ์หาย = ถอนออกทันที"
+    try{ await mountPrivateWorkspace(); }
+    catch(err){ console.warn('[workspace]', safeError(err)); }
   }catch(err){
     sbErr = safeError(err);
     console.warn('[sync]', sbErr);
@@ -6624,6 +6631,11 @@ function pwsApprovedOrigin(){
 /** ถอนทุกอย่างที่ loader สร้างไว้ · เรียกซ้ำได้ปลอดภัย */
 function teardownPrivateWorkspace(){
   if(!pwsState) return;
+  // ให้ bundle เก็บกวาดของตัวเองก่อน (timer, listener ที่ผูกไว้นอก panel)
+  try{
+    const handle = pwsState.handle;
+    if(handle && typeof handle.destroy === 'function') handle.destroy();
+  }catch(err){}
   try{ if(pwsState.navEl && pwsState.navEl.parentNode) pwsState.navEl.parentNode.removeChild(pwsState.navEl); }catch(err){}
   try{ if(pwsState.panelEl && pwsState.panelEl.parentNode) pwsState.panelEl.parentNode.removeChild(pwsState.panelEl); }catch(err){}
   // ปล่อย Blob URL คืน ไม่งั้นโค้ดของ workspace ยังถูกอ้างถึงได้หลังผู้ใช้ออกจากระบบ
@@ -6674,8 +6686,14 @@ async function mountPrivateWorkspace(){
     return;
   }
 
-  // ของเดิมที่ mount ไว้แล้วรุ่นเดียวกัน ไม่ต้องทำซ้ำ
-  if(pwsState && pwsState.version === manifest.version) return;
+  // กุญแจต้องมี mode ด้วย ไม่ใช่แค่ version
+  //
+  // สองโหมดใช้เลข version เดียวกันได้ตามปกติ ถ้าเทียบแค่ version คนที่ถูกลดสิทธิ์
+  // ลงมาเป็นโหมดที่แคบกว่า จะยังถือ bundle ของโหมดกว้างไว้ในเบราว์เซอร์ต่อไป
+  // เพราะโค้ดคิดว่า "ของเดิมยังใช้ได้" · และถ้า manifest ไม่ส่ง version มาเลย
+  // undefined === undefined จะเป็นจริง แล้วมันจะไม่ mount อะไรเลยตลอดกาล
+  const pwsKey = String(manifest.version || '') + '\u0000' + String(manifest.mode || '');
+  if(pwsState && pwsState.key === pwsKey) return;
   teardownPrivateWorkspace();
 
   let source;
@@ -6689,23 +6707,31 @@ async function mountPrivateWorkspace(){
     source = await res.text();
   }catch(err){ return; }
 
-  const nav = pwsCreateNav(manifest.label);
+  // สร้าง panel ก่อน · ถ้าสร้างปุ่มก่อนแล้ว panel ล้ม ปุ่มจะค้างอยู่โดยที่ pwsState
+  // ยังเป็น null ทำให้ teardown เอาออกไม่ได้ตลอดกาล
   const panel = pwsCreatePanel();
-  if(!nav || !panel) return;
+  if(!panel) return;
+  const nav = pwsCreateNav(manifest.label);
+  if(!nav){ if(panel.parentNode) panel.parentNode.removeChild(panel); return; }
 
   let blobUrl = '';
   try{
     blobUrl = URL.createObjectURL(new Blob([source], {type:'text/javascript'}));
   }catch(err){ blobUrl = ''; }
 
-  pwsState = {navEl:nav, panelEl:panel, blobUrl:blobUrl, version:manifest.version};
+  pwsState = {navEl:nav, panelEl:panel, blobUrl:blobUrl, key:pwsKey, handle:null};
 
   if(blobUrl){
     try{
       const mod = await import(blobUrl);
       // ชื่อ export ต้องเป็นชื่อกลาง ๆ · ไฟล์นี้ต้องไม่รู้ว่า workspace ที่โหลดมาคืออะไร
       const mount = (mod && (mod.mount || mod.default)) || window.__pwsMounted;
-      if(typeof mount === 'function') mount(panel, {mode:manifest.mode});
+      if(typeof mount === 'function'){
+        // เก็บ handle ไว้ · ถ้าทิ้ง destroy() จะไม่มีวันถูกเรียก แล้ว bundle ที่ตั้ง
+        // timer หรือผูก listener ไว้ที่ window จะรอดจากการออกจากระบบ
+        const handle = mount(panel, {mode:manifest.mode});
+        if(pwsState) pwsState.handle = handle;
+      }
     }catch(err){
       // bundle รันไม่ได้ ก็ยังคงแท็บไว้พร้อมข้อความ ดีกว่าหายไปเฉย ๆ โดยไม่บอกอะไร
       panel.textContent = 'เปิดพื้นที่ทำงานส่วนตัวไม่สำเร็จ กรุณาลองใหม่';
